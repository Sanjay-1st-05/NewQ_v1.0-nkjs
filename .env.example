# NewQ backend configuration — copy to .env and fill in real values.
# Never commit the real .env file.

# Google Gemini API key (backend only — never place in mobile code)
GEMINI_API_KEY=

# Gemini model to use for analysis (e.g. gemini-2.0-flash)
GEMINI_MODEL=

# Stage 6 hardening (optional — defaults shown in backend/hardening.py)
# NEWQ_RATE_LIMIT_ANALYZE=10       # analyze requests per minute per IP
# NEWQ_RATE_LIMIT_EXTRACT=20       # extract-text requests per minute per IP
# NEWQ_MAX_CONTENT_LENGTH=20000    # maximum article characters
# NEWQ_AGENT=1                     # 0 disables the agent pipeline
# NEWQ_AGENT_MAX_REPAIRS=1         # repair passes per analysis

# News feed override (comma-separated RSS URLs); defaults are in
# backend/news_feed_service.py
# NEWQ_FEED_URLS=

# Stage 7 authentication (Firebase ID-token guard)
# Path to the service-account JSON downloaded from the Firebase console
# (Project settings -> Service accounts -> Generate new private key).
# The file is a SECRET and must never be committed (.gitignore covers it).
# FIREBASE_SERVICE_ACCOUNT=firebase-service-account.json
# Enforcement mode: auto (default) when omitted - enforce only when the
# service-account JSON exists + firebase-admin is installed.
# NEWQ_REQUIRE_AUTH=auto          # auto | on | off
